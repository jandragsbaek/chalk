{
  "name": "chalk",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "vp run --parallel --filter @chalk/server --filter @chalk/web dev",
    "build": "vp run --filter @chalk/web build",
    "start": "vp run --filter @chalk/server start",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp run -r test",
    "lint": "vp lint --report-unused-disable-directives",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp fmt --check && vp lint --report-unused-disable-directives && vp run -r --cache typecheck && vp run -r test"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1"
}
